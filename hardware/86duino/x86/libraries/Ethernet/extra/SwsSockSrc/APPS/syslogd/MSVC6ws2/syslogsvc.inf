;-------------------------------------------------------------------------
; SYSLOGSVC.INF -- Syslog service
;
; Copyright (c) 2003, Lawrence Rust, Software Systems
; 04-Apr-05 lvr Added Win9x
; 25-Jun-03 lvr Created
;-------------------------------------------------------------------------

[version]
signature="$Chicago$"


;-------------------------------------------------------------------------
; Installation Section
;-------------------------------------------------------------------------

[DefaultInstall]
;Win9x
CopyFiles = Service.Files.Inf, Service.Files.Sys, AppFiles
DelFiles  = Service.Files.Sys.Del
AddReg    = Service.Add.Reg
UpdateInis = AddLinks 
Reboot

[Service.Add.Reg]
HKLM,Software\Microsoft\Windows\CurrentVersion\RunServices,SyslogSvc,,"%24%\%AppFolder%\SyslogSvc.exe"
HKLM,%UIF%
HKLM,%UIF%,DisplayName,,"%RemoveService%"
;128=No reboot, 129=Always reboot, 130=Prompt reboot, 131=Auto reboot, 132=Auto reboot + prompt
HKLM,%UIF%,UninstallString,,"rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\SyslogSvc.inf"


[DefaultInstall.nt]
;Win2k,XP
CopyFiles = Service.Files.Inf, Service.Files.Sys, AppFiles
DelFiles  = Service.Files.Sys.Del
AddReg    = Service.Add.Reg.nt
;ProfileItems = StartCfg, StartHlp
UpdateInis = AddLinks 
Reboot

[Service.Add.Reg.nt]
HKLM,%UIF%
HKLM,%UIF%,DisplayName,,"%RemoveService%"
;128=No reboot, 129=Always reboot, 130=Prompt reboot, 131=Auto reboot, 132=Auto reboot + prompt
HKLM,%UIF%,UninstallString,,"rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\SyslogSvc.inf"


;-------------------------------------------------------------------------
; Service installation support
;-------------------------------------------------------------------------

[DefaultInstall.nt.Services]
AddService= %Product%, 0, Service_Install ;, EventLog_Inst

[Service_Install]
DisplayName    = %Product%
Description    = %Description%
ServiceType    = 0x10 ; SERVICE_WIN32_OWN_PROCESS
StartType      = 2 ;2=SERVICE_AUTO_START,3=SERVICE_DEMAND_START
ErrorControl   = 1  ; 0= IGNORE , 1= WARN
ServiceBinary  = %24%\%AppFolder%\SyslogSvc.exe
AddReg         = Service_Params
Dependencies   = LanmanWorkstation

[Service_Params]
HKR,Parameters,Trace,0x10003,1

[EventLog_Inst]
;AddReg = EventLog_AddReg

[EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\SyslogSvc.exe"
HKR,,TypesSupported,0x00010001,7


;-------------------------------------------------------------------------
; Start menu items
;-------------------------------------------------------------------------

[AddLinks]
setup.ini, progman.groups,, "SyslogSvc=%GROUP%" ;creates folder
;setup.ini, SyslogSvc,, """%AppName%"", %24%\%AppFolder%\SyslogSvc.exe" ;creates link
;setup.ini, SyslogSvc,, """%AppHelp%"", %24%\%AppFolder%\SyslogSvc.hlp" ;creates link
;setup.ini, SyslogSvc,, """%AppReadme%"", %24%\%AppFolder%\readme.txt" ;creates link
setup.ini, SyslogSvc,, """%AppRemove%"", ""rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\SyslogSvc.inf"""

[RemoveLinks]
;Removes shortcut during uninstall:
setup.ini, progman.groups,, "SyslogSvc=%GROUP%" ;creates folder
;setup.ini, SyslogSvc,, """%AppName%""" ;deletes link
;setup.ini, SyslogSvc,, """%AppHelp%""" ;deletes link
;setup.ini, SyslogSvc,, """%AppReadme%""" ;deletes link
setup.ini, SyslogSvc,, """%AppRemove%""" ;deletes link


[StartCfg]
Name= %AppName%,0
CmdLine= 24,%AppFolder%,SyslogSvc.exe
WorkingDir= 24,%AppFolder%
Subdir = %GROUP%
InfoTip= %AppInfo%

[StartCfg.Remove]
Name= %AppName%,2
CmdLine= 24,%AppFolder%,SyslogSvc.exe
Subdir = %GROUP%


[StartHlp]
Name= %AppHelp%,0
CmdLine= 24,%AppFolder%,SyslogSvc.hlp
WorkingDir= 24,%AppFolder%
Subdir = %GROUP%
InfoTip= %AppHelpInfo%

[StartHlp.Remove]
Name= %AppHelp%,2
CmdLine= 24,%AppFolder%,SyslogSvc.hlp
Subdir = %GROUP%


;-------------------------------------------------------------------------
; Removal Section
;-------------------------------------------------------------------------
[DefaultUnInstall]
;Win9x
DelReg    = Service.Del.Reg
DelFiles  = Service.Files.Inf.Remove, Service.Files.Sys.Remove, AppFiles.Remove
UpdateInis = RemoveLinks 

[Service.Del.Reg]
HKLM,Software\Microsoft\Windows\CurrentVersion\RunServices,SyslogSvc
HKLM,%UIF%

[DefaultUnInstall.nt]
;Win2k
DelReg    = Service.Del.Reg.nt
DelFiles  = Service.Files.Inf.Remove, Service.Files.Sys.Remove, AppFiles.Remove
;ProfileItems = StartCfg.Remove, StartHlp.Remove
UpdateInis = RemoveLinks 

[DefaultUnInstall.nt.Services]
DelService= %Product%, 0x204 ; 0x200= SPSVCINST_STOPSERVICE, 4= SPSVCINST_DELETEEVENTLOGENTRY

[Service.Del.Reg.nt]
HKLM,%UIF%


;-------------------------------------------------------------------------
; Declare Destination Directories for file copy/deletion
;-------------------------------------------------------------------------

[SourceDisksNames]
1=%DiskId1%,"",1

[SourceDisksFiles]
SyslogSvc.inf=1
SyslogSvc.exe=1
SyslogSvc.ini=1
;SyslogSvc.hlp=1
;SyslogSvc.cnt=1
;readme.txt=1

[DestinationDirs]
Service.Files.Inf = 17
Service.Files.Inf.Remove = 17
Service.Files.Sys = 24,%AppFolder%
Service.Files.Sys.Remove = 24,%AppFolder%
Service.Files.Sys.Del = 24,%AppFolder%
AppFiles = 24,%AppFolder%
AppFiles.Remove = 24,%AppFolder%

[Service.Files.Inf]
SyslogSvc.inf

[Service.Files.Inf.Remove]
SyslogSvc.inf
SyslogSvc.pnf

[Service.Files.Sys]
SyslogSvc.ini,,,0 ; 0x10= COPYFLG_NO_OVERWRITE
SyslogSvc.exe

[Service.Files.Sys.Del]

[Service.Files.Sys.Remove]
SyslogSvc.exe,,,0x1 ; 1= DELFLG_IN_USE
SyslogSvc.ini,,,0x1 ; 1= DELFLG_IN_USE

[AppFiles]
;SyslogSvc.exe
;SyslogSvc.hlp
;SyslogSvc.cnt
;readme.txt

[AppFiles.Remove]
;SyslogSvc.exe,,,0x1
;SyslogSvc.hlp,,,0x1
;SyslogSvc.cnt,,,0x1
;SyslogSvc.gid,,,0x1
;readme.txt


;-------------------------------------------------------------------------
; Localised strings
;-------------------------------------------------------------------------

[Strings]
Provider= "Software Systems Consultants"
Product= "Syslog Service"
Description= "Logs system messages"
DiskId1= "Installation Disk 1"
RemoveService= "Syslog Service (remove only)"
UIF= "Software\Microsoft\Windows\CurrentVersion\Uninstall\SyslogSvc"
AppName="Syslog setup"
AppInfo="Configure Syslog"
AppHelp="Syslog help"
AppReadme="ReadMe"
AppHelpInfo="Help on using Syslog"
AppRemove="Uninstall Syslog Service"
AppFolder="PROGRA~1\SoftSyst\SyslogSvc"
GROUP="Syslog"
