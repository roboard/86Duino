;-------------------------------------------------------------------------
; INETSVC.INF -- Internet services
;
; Copyright (c) 2003, Lawrence Rust, Software Systems
; 04-Apr-05 lvr Added Win9x
; 26-Feb-03 lvr Created
;-------------------------------------------------------------------------

[version]
signature="$Chicago$"


;-------------------------------------------------------------------------
; Installation Section
;-------------------------------------------------------------------------

[DefaultInstall]
;Win9x
CopyFiles = Service.Files.Inf, Service.Files.Sys, AppFiles
DelFiles  = Service.Files.Sys.Del
AddReg    = Service.Add.Reg
UpdateInis = AddLinks 
Reboot

[Service.Add.Reg]
HKLM,Software\Microsoft\Windows\CurrentVersion\RunServices,InetSvc,,"%24%\%AppFolder%\InetSvc.exe"
HKLM,%UIF%
HKLM,%UIF%,DisplayName,,"%RemoveService%"
;128=No reboot, 129=Always reboot, 130=Prompt reboot, 131=Auto reboot, 132=Auto reboot + prompt
HKLM,%UIF%,UninstallString,,"rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\InetSvc.inf"


[DefaultInstall.nt]
;Win2k,XP
CopyFiles = Service.Files.Inf, Service.Files.Sys, AppFiles
DelFiles  = Service.Files.Sys.Del
AddReg    = Service.Add.Reg.nt
;ProfileItems = StartCfg, StartHlp
UpdateInis = AddLinks 
Reboot

[Service.Add.Reg.nt]
HKLM,%UIF%
HKLM,%UIF%,DisplayName,,"%RemoveService%"
;128=No reboot, 129=Always reboot, 130=Prompt reboot, 131=Auto reboot, 132=Auto reboot + prompt
HKLM,%UIF%,UninstallString,,"rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\InetSvc.inf"


;-------------------------------------------------------------------------
; Service installation support
;-------------------------------------------------------------------------

[DefaultInstall.nt.Services]
AddService= %Product%, 0, Service_Install ;, EventLog_Inst

[Service_Install]
DisplayName    = %Product%
Description    = %Description%
ServiceType    = 0x10 ; SERVICE_WIN32_OWN_PROCESS
StartType      = 2 ;2=SERVICE_AUTO_START,3=SERVICE_DEMAND_START
ErrorControl   = 1  ; 0= IGNORE , 1= WARN
ServiceBinary  = %24%\%AppFolder%\InetSvc.exe
AddReg         = Service_Params
Dependencies   = LanmanWorkstation

[Service_Params]
HKR,Parameters,Trace,0x10003,1

[EventLog_Inst]
;AddReg = EventLog_AddReg

[EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\InetSvc.exe"
HKR,,TypesSupported,0x00010001,7


;-------------------------------------------------------------------------
; Start menu items
;-------------------------------------------------------------------------

[AddLinks]
setup.ini, progman.groups,, "InetSvc=%GROUP%" ;creates folder
;setup.ini, InetSvc,, """%AppName%"", %24%\%AppFolder%\InetSvc.exe" ;creates link
;setup.ini, InetSvc,, """%AppHelp%"", %24%\%AppFolder%\InetSvc.hlp" ;creates link
;setup.ini, InetSvc,, """%AppReadme%"", %24%\%AppFolder%\readme.txt" ;creates link
setup.ini, InetSvc,, """%AppRemove%"", ""rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\InetSvc.inf"""

[RemoveLinks]
;Removes shortcut during uninstall:
setup.ini, progman.groups,, "InetSvc=%GROUP%" ;creates folder
;setup.ini, InetSvc,, """%AppName%""" ;deletes link
;setup.ini, InetSvc,, """%AppHelp%""" ;deletes link
;setup.ini, InetSvc,, """%AppReadme%""" ;deletes link
setup.ini, InetSvc,, """%AppRemove%""" ;deletes link


[StartCfg]
Name= %AppName%,0
CmdLine= 24,%AppFolder%,InetSvc.exe
WorkingDir= 24,%AppFolder%
Subdir = %GROUP%
InfoTip= %AppInfo%

[StartCfg.Remove]
Name= %AppName%,2
CmdLine= 24,%AppFolder%,InetSvc.exe
Subdir = %GROUP%


[StartHlp]
Name= %AppHelp%,0
CmdLine= 24,%AppFolder%,InetSvc.hlp
WorkingDir= 24,%AppFolder%
Subdir = %GROUP%
InfoTip= %AppHelpInfo%

[StartHlp.Remove]
Name= %AppHelp%,2
CmdLine= 24,%AppFolder%,InetSvc.hlp
Subdir = %GROUP%


;-------------------------------------------------------------------------
; Removal Section
;-------------------------------------------------------------------------
[DefaultUnInstall]
;Win9x
DelReg    = Service.Del.Reg
DelFiles  = Service.Files.Inf.Remove, Service.Files.Sys.Remove, AppFiles.Remove
UpdateInis = RemoveLinks 

[Service.Del.Reg]
HKLM,Software\Microsoft\Windows\CurrentVersion\RunServices,InetSvc
HKLM,%UIF%

[DefaultUnInstall.nt]
;Win2k
DelReg    = Service.Del.Reg.nt
DelFiles  = Service.Files.Inf.Remove, Service.Files.Sys.Remove, AppFiles.Remove
;ProfileItems = StartCfg.Remove, StartHlp.Remove
UpdateInis = RemoveLinks 

[DefaultUnInstall.nt.Services]
DelService= %Product%, 0x204 ; 0x200= SPSVCINST_STOPSERVICE, 4= SPSVCINST_DELETEEVENTLOGENTRY

[Service.Del.Reg.nt]
HKLM,%UIF%


;-------------------------------------------------------------------------
; Declare Destination Directories for file copy/deletion
;-------------------------------------------------------------------------

[SourceDisksNames]
1=%DiskId1%,"",1

[SourceDisksFiles]
InetSvc.inf=1
InetSvc.exe=1
InetSvc.ini=1
;InetSvc.hlp=1
;InetSvc.cnt=1
;readme.txt=1

[DestinationDirs]
Service.Files.Inf = 17
Service.Files.Inf.Remove = 17
Service.Files.Sys = 24,%AppFolder%
Service.Files.Sys.Remove = 24,%AppFolder%
Service.Files.Sys.Del = 24,%AppFolder%
AppFiles = 24,%AppFolder%
AppFiles.Remove = 24,%AppFolder%

[Service.Files.Inf]
InetSvc.inf

[Service.Files.Inf.Remove]
InetSvc.inf
InetSvc.pnf

[Service.Files.Sys]
InetSvc.ini,,,0 ; 0x10= COPYFLG_NO_OVERWRITE
InetSvc.exe

[Service.Files.Sys.Del]

[Service.Files.Sys.Remove]
InetSvc.exe,,,0x1 ; 1= DELFLG_IN_USE
InetSvc.ini,,,0x1 ; 1= DELFLG_IN_USE

[AppFiles]
;InetSvc.exe
;InetSvc.hlp
;InetSvc.cnt
;readme.txt

[AppFiles.Remove]
;InetSvc.exe,,,0x1
;InetSvc.hlp,,,0x1
;InetSvc.cnt,,,0x1
;InetSvc.gid,,,0x1
;readme.txt


;-------------------------------------------------------------------------
; Localised strings
;-------------------------------------------------------------------------

[Strings]
Provider= "Software Systems Consultants"
Product="Internet Services"
Description="FTP, HTTP, SMTP, POP and Telnet services"
DiskId1= "Installation Disk 1"
RemoveService= "Internet Services (remove only)"
UIF= "Software\Microsoft\Windows\CurrentVersion\Uninstall\InetSvc"
AppName="Internet services setup"
AppInfo="Configure Internet services"
AppHelp="Help"
AppHelpInfo="Help on using Internet services"
AppReadme="ReadMe"
AppRemove="Uninstall"
AppFolder="PROGRA~1\SoftSyst\InetSvc"
GROUP="InetSvc"
