#!/usr/bin/make
# build whois
#
# REVISION HISTORY
#
#  No  Date       By   Reason
# -------------------------------------------------------------------------
#  02  17 May 09  lvr  Revised to use included makefile
#  01  08 Aug 06  lvr  Creation
# -------------------------------------------------------------------------
#
# Platforms
#----------
# Linux (gcc 4.1 and 4.2) builds and runs OK.
# XDJGPP 2.04 (gcc 4.3) builds and runs OK.
# XMINGW32 (gcc 4.2) builds OK.

TARGET = whois
SOURCES := $(TARGET) main
BSDSOURCES := $(TARGET) main
SRCPATH = ..
INCPATH = ..
ifndef SWSSOCK
 SOURCES += sws_cfg sws_str
endif

# Swssock
ROOT_DIR = ../../..
include $(ROOT_DIR)/LIBS/gnu/makefile

$(call obj-var,main,CPPFLAGS += -DPACKET_DUMP=1)

# Whois registration sources
TLDS = http://data.iana.org/TLD/tlds-alpha-by-domain.txt
#IPV4 = http://www.iana.org/assignments/ipv4-address-space
IPV4 = http://www.iana.org/assignments/ipv4-address-space/ipv4-address-space.txt

# whois.ini dependencies
whois.ini : tlds.in ipv4
	@cat whois0.in > $@
	@echo >> $@
	@cat tlds.in >> $@
	@cat whois1.in >> $@
	@echo >> $@
	@cat whois2.in >> $@
	@echo "\n# Generated by ipv4.sh from $(IPV4)">> $@
	@./ipv4.sh ipv4 >> $@
	@cat whois3.in >> $@

tlds :
	wget -q -O $@ $(TLDS)

tlds.in : tlds
	@echo "# Generated by tlds.sh from $(TLDS)"> $@
	./tlds.sh $< | tee -a $@

ipv4 :
	wget -q -O $@ $(IPV4)

clean-ini :
	@-$(call rm,whois.ini)
	@-$(call rd,whois)
	@-$(call rm,tlds.in)
	@-$(call rm,tlds)
	@-$(call rm,ipv4)

clean : clean-ini
