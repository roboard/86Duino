;-------------------------------------------------------------------------
; IDENTSVC.INF -- Ident service
;
; Copyright (c) 2005, Lawrence Rust, Software Systems
; 04-Apr-05 lvr Added Win9x
; 05-Jan-05 lvr Created
;-------------------------------------------------------------------------

[version]
signature="$Chicago$"


;-------------------------------------------------------------------------
; Installation Section
;-------------------------------------------------------------------------

[DefaultInstall]
;Win9x
CopyFiles = Service.Files.Inf, Service.Files.Sys, AppFiles
DelFiles  = Service.Files.Sys.Del
AddReg    = Service.Add.Reg
UpdateInis = AddLinks 
Reboot

[Service.Add.Reg]
HKLM,Software\Microsoft\Windows\CurrentVersion\RunServices,IdentSvc,,"%24%\%AppFolder%\IdentSvc.exe"
HKLM,%UIF%
HKLM,%UIF%,DisplayName,,"%RemoveService%"
;128=No reboot, 129=Always reboot, 130=Prompt reboot, 131=Auto reboot, 132=Auto reboot + prompt
HKLM,%UIF%,UninstallString,,"rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\IdentSvc.inf"


[DefaultInstall.nt]
;Win2k,XP
CopyFiles = Service.Files.Inf, Service.Files.Sys, AppFiles
DelFiles  = Service.Files.Sys.Del
AddReg    = Service.Add.Reg.nt
;ProfileItems = StartCfg, StartHlp
UpdateInis = AddLinks 
Reboot

[Service.Add.Reg.nt]
HKLM,%UIF%
HKLM,%UIF%,DisplayName,,"%RemoveService%"
;128=No reboot, 129=Always reboot, 130=Prompt reboot, 131=Auto reboot, 132=Auto reboot + prompt
HKLM,%UIF%,UninstallString,,"rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\IdentSvc.inf"


;-------------------------------------------------------------------------
; Service installation support
;-------------------------------------------------------------------------

[DefaultInstall.nt.Services]
AddService= %Product%, 0, Service_Install ;, EventLog_Inst

[Service_Install]
DisplayName    = %Product%
Description    = %Description%
ServiceType    = 0x10 ; SERVICE_WIN32_OWN_PROCESS
StartType      = 2 ;2=SERVICE_AUTO_START,3=SERVICE_DEMAND_START
ErrorControl   = 1  ; 0= IGNORE , 1= WARN
ServiceBinary  = %24%\%AppFolder%\IdentSvc.exe
AddReg         = Service_Params
Dependencies   = LanmanWorkstation

[Service_Params]
HKR,Parameters,Trace,0x10003,1

[EventLog_Inst]
;AddReg = EventLog_AddReg

[EventLog_AddReg]
HKR,,EventMessageFile,0x00020000,"%SystemRoot%\System32\IoLogMsg.dll;%SystemRoot%\System32\IdentSvc.exe"
HKR,,TypesSupported,0x00010001,7


;-------------------------------------------------------------------------
; Start menu items
;-------------------------------------------------------------------------

[AddLinks]
setup.ini, progman.groups,, "IdentSvc=%GROUP%" ;creates folder
;setup.ini, IdentSvc,, """%AppName%"", %24%\%AppFolder%\IdentSvc.exe" ;creates link
;setup.ini, IdentSvc,, """%AppHelp%"", %24%\%AppFolder%\IdentSvc.hlp" ;creates link
;setup.ini, IdentSvc,, """%AppReadme%"", %24%\%AppFolder%\readme.txt" ;creates link
setup.ini, IdentSvc,, """%AppRemove%"", ""rundll32.exe setupapi.dll,InstallHinfSection DefaultUninstall 130 %17%\IdentSvc.inf"""

[RemoveLinks]
;Removes shortcut during uninstall:
setup.ini, progman.groups,, "IdentSvc=%GROUP%" ;creates folder
;setup.ini, IdentSvc,, """%AppName%""" ;deletes link
;setup.ini, IdentSvc,, """%AppHelp%""" ;deletes link
;setup.ini, IdentSvc,, """%AppReadme%""" ;deletes link
setup.ini, IdentSvc,, """%AppRemove%""" ;deletes link


[StartCfg]
Name= %AppName%,0
CmdLine= 24,%AppFolder%,IdentSvc.exe
WorkingDir= 24,%AppFolder%
Subdir = %GROUP%
InfoTip= %AppInfo%

[StartCfg.Remove]
Name= %AppName%,2
CmdLine= 24,%AppFolder%,IdentSvc.exe
Subdir = %GROUP%


[StartHlp]
Name= %AppHelp%,0
CmdLine= 24,%AppFolder%,IdentSvc.hlp
WorkingDir= 24,%AppFolder%
Subdir = %GROUP%
InfoTip= %AppHelpInfo%

[StartHlp.Remove]
Name= %AppHelp%,2
CmdLine= 24,%AppFolder%,IdentSvc.hlp
Subdir = %GROUP%


;-------------------------------------------------------------------------
; Removal Section
;-------------------------------------------------------------------------
[DefaultUnInstall]
;Win9x
DelReg    = Service.Del.Reg
DelFiles  = Service.Files.Inf.Remove, Service.Files.Sys.Remove, AppFiles.Remove
UpdateInis = RemoveLinks 

[Service.Del.Reg]
HKLM,Software\Microsoft\Windows\CurrentVersion\RunServices,IdentSvc
HKLM,%UIF%

[DefaultUnInstall.nt]
;Win2k
DelReg    = Service.Del.Reg.nt
DelFiles  = Service.Files.Inf.Remove, Service.Files.Sys.Remove, AppFiles.Remove
;ProfileItems = StartCfg.Remove, StartHlp.Remove
UpdateInis = RemoveLinks 

[DefaultUnInstall.nt.Services]
DelService= %Product%, 0x204 ; 0x200= SPSVCINST_STOPSERVICE, 4= SPSVCINST_DELETEEVENTLOGENTRY

[Service.Del.Reg.nt]
HKLM,%UIF%


;-------------------------------------------------------------------------
; Declare Destination Directories for file copy/deletion
;-------------------------------------------------------------------------

[SourceDisksNames]
1=%DiskId1%,"",1

[SourceDisksFiles]
IdentSvc.inf=1
IdentSvc.exe=1
IdentSvc.ini=1
;IdentSvc.hlp=1
;IdentSvc.cnt=1
;readme.txt=1

[DestinationDirs]
Service.Files.Inf = 17
Service.Files.Inf.Remove = 17
Service.Files.Sys = 24,%AppFolder%
Service.Files.Sys.Remove = 24,%AppFolder%
Service.Files.Sys.Del = 24,%AppFolder%
AppFiles = 24,%AppFolder%
AppFiles.Remove = 24,%AppFolder%

[Service.Files.Inf]
IdentSvc.inf

[Service.Files.Inf.Remove]
IdentSvc.inf
IdentSvc.pnf

[Service.Files.Sys]
IdentSvc.ini,,,0 ; 0x10= COPYFLG_NO_OVERWRITE
IdentSvc.exe

[Service.Files.Sys.Del]

[Service.Files.Sys.Remove]
IdentSvc.exe,,,0x1 ; 1= DELFLG_IN_USE
IdentSvc.ini,,,0x1 ; 1= DELFLG_IN_USE

[AppFiles]
;IdentSvc.exe
;IdentSvc.hlp
;IdentSvc.cnt
;readme.txt

[AppFiles.Remove]
;IdentSvc.exe,,,0x1
;IdentSvc.hlp,,,0x1
;IdentSvc.cnt,,,0x1
;IdentSvc.gid,,,0x1
;readme.txt


;-------------------------------------------------------------------------
; Localised strings
;-------------------------------------------------------------------------

[Strings]
Provider= "Software Systems Consultants"
Product="Ident Service"
Description="TCP/IP ident service"
DiskId1= "Installation Disk 1"
RemoveService= "Ident Service (remove only)"
UIF= "Software\Microsoft\Windows\CurrentVersion\Uninstall\IdentSvc"
AppName="Ident setup"
AppInfo="Configure Ident"
AppHelp="Ident help"
AppReadme="ReadMe"
AppHelpInfo="Help on using Ident"
AppRemove="Uninstall Ident Service"
AppFolder="PROGRA~1\SoftSyst\IdentSvc"
GROUP="Ident"
