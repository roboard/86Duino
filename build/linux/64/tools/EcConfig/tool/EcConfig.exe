#!/bin/bash
# Self-contained launcher for EcConfig. Point the loader at the bundled
# libraries in this folder, then run the real binary from here (the exe derives
# its resource path from argv[0], so an absolute path keeps fonts/images working
# no matter the current directory).
DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export LD_LIBRARY_PATH="$DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$DIR/EcConfig" "$@"
